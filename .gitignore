# Dependencies
node_modules/
package-lock.json

# -----------------------------------------------
# IMAGES: Uploaded media files
# Large images are stored via Netlify CMS media
# and served from Netlify CDN directly.
# Exclude from git to keep repo fast to clone.
# -----------------------------------------------
images/uploads/*
# Keep the folder itself tracked (so the dir exists)
!images/uploads/.gitkeep

# Build files
dist/
build/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp

# Large video files (store these elsewhere or on video hosting platform)
*.mov
*.mp4
*.avi

# Backup files
*.bak
*.backup
